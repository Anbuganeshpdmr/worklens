<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">


    <!-- 1. manual correcting status for null end-date columns -->
    <changeSet id="manual-fix-status-for-null-end-date-column" author="anbu">

        <sql>
            UPDATE entries e
            JOIN statuses s
            ON s.record_name = 'ENTRY'
            AND s.display_name = 'in-process'
            SET e.status_id = s.id
            WHERE e.end_date_time IS NULL;
        </sql>

    </changeSet>
</databaseChangeLog>